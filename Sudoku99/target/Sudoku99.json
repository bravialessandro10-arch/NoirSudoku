{"noir_version":"1.0.0-beta.18+99bb8b5cf33d7669adbdef096b12d80f30b4c0c9","hash":"13220540759343030160","abi":{"parameters":[{"name":"problema","type":{"kind":"array","length":9,"type":{"kind":"array","length":9,"type":{"kind":"integer","sign":"unsigned","width":32}}},"visibility":"public"},{"name":"soluzione","type":{"kind":"array","length":9,"type":{"kind":"array","length":9,"type":{"kind":"integer","sign":"unsigned","width":32}}},"visibility":"private"}],"return_type":null,"error_types":{"1998584279744703196":{"error_kind":"string","string":"attempt to subtract with overflow"},"14990209321349310352":{"error_kind":"string","string":"attempt to add with overflow"}}},"bytecode":"","debug_symbols":"","file_map":{"51":{"source":"// Sudoku 99 Circuit\n// Verifica che una soluzione sia valida per un dato problema\n\nfn main(\n    // Problema Sudoku (pubblico) - 0 = cella vuota\n    problema: pub [[u32; 9]; 9],\n    \n    // Soluzione (privata)\n    soluzione: [[u32; 9]; 9]\n) {\n    // 1. Verifica valori ammissibili (1-9)\n    for i in 0..9 {\n        for j in 0..9 {\n            assert(soluzione[i][j] >= 1);\n            assert(soluzione[i][j] <= 9);\n        }\n    }\n    \n    // 2. Verifica unicita righe\n    for i in 0..9 {\n        verifica_unicita(soluzione[i]);\n    }\n    \n    // 3. Verifica unicita colonne\n    for j in 0..9 {\n        let mut colonna = [0 as u32; 9];\n        for i in 0..9 {\n            colonna[i] = soluzione[i][j];\n        }\n        verifica_unicita(colonna);\n    }\n    \n    // 4. Verifica unicita blocchi 3x3\n    for blocco_riga in 0..3 {\n        for blocco_col in 0..3 {\n            let mut blocco = [0 as u32; 9];\n            let mut indice = 0;\n            \n            for i in 0..3 {\n                for j in 0..3 {\n                    let riga = blocco_riga * 3 + i;\n                    let col = blocco_col * 3 + j;\n                    blocco[indice] = soluzione[riga][col];\n                    indice += 1;\n                }\n            }\n            \n            verifica_unicita(blocco);\n        }\n    }\n    \n    // 5. Verifica coerenza con problema iniziale\n    for i in 0..9 {\n        for j in 0..9 {\n            // Se problema[i][j] != 0, deve matchare soluzione\n            if problema[i][j] != 0 {\n                assert(soluzione[i][j] == problema[i][j]);\n            }\n        }\n    }\n    \n    \n}\n\n// Funzione helper: verifica che array contenga [1,2,3,4,5,6,7,8,9] esattamente una volta\nfn verifica_unicita(arr: [u32; 9]) {\n    let mut occorrenze = [0 as u32; 9];\n    \n    // Conta occorrenze di ogni numero\n    for i in 0..9 {\n        let valore = arr[i];\n        let indice = valore - 1;\n        occorrenze[indice] += 1;\n    }\n    \n    // Ogni numero deve apparire esattamente 1 volta\n    for i in 0..9 {\n        assert(occorrenze[i] == 1);\n    }\n}","path":"/home/alebravi/Noir/Sudoku99/src/main.nr"}},"expression_width":{"Bounded":{"width":4}}}